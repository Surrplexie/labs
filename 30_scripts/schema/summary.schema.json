{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Surrplexie/labs/30_scripts/schema/summary.schema.json",
  "title": "labs dist/summary.json",
  "description": "Schema v1 for the machine-readable export produced by export-summary.ps1.",
  "type": "object",
  "required": ["schema_version", "generated_at", "record_count", "records"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Schema version for this export envelope."
    },
    "generated_at": {
      "type": "string",
      "description": "ISO-8601 UTC timestamp of when this file was generated."
    },
    "record_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of records (active + reserve) in this export."
    },
    "active_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of non-empty/active sample records."
    },
    "reserve_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Count of empty/reserve sample slots."
    },
    "records": {
      "type": "array",
      "description": "Merged sample records from tracker CSV, findings frontmatter, and IOC CSV.",
      "items": {
        "type": "object",
        "required": ["sample_id", "status"],
        "properties": {
          "schema_version": {
            "type": "integer",
            "description": "Schema version inherited from the source findings file, if present."
          },
          "sample_id": {
            "type": "string",
            "pattern": "^sample_[0-9]{2}$"
          },
          "sha256": { "type": "string" },
          "name_tag": { "type": "string" },
          "status": { "type": "string" },
          "verdict": { "type": "string" },
          "family_guess": { "type": "string" },
          "family_confidence": { "type": "string" },
          "analyst": { "type": "string" },
          "date_acquired": { "type": "string" },
          "date_analyzed": { "type": "string" },
          "mb_url": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "mitre_techniques": {
            "type": "array",
            "items": { "type": "string" }
          },
          "ioc_count": { "type": "integer" },
          "procmon_run": { "type": "string" },
          "dynamic_complete": { "type": "string" },
          "has_frontmatter": { "type": "boolean" }
        }
      }
    }
  },
  "_breaking_changes": {
    "1": "Initial schema. Envelope wraps records array with schema_version, generated_at, and counts."
  }
}
