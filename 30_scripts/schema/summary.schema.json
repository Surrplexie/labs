{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dist/summary.json envelope (schema_version 2)",
  "description": "Machine-readable export of all engagement records. Generated by export-summary.ps1.",
  "type": "object",
  "required": ["schema_version", "generated_at", "record_count", "active_count", "reserve_count", "records"],
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "generated_at":   { "type": "string" },
    "record_count":   { "type": "integer" },
    "active_count":   { "type": "integer" },
    "reserve_count":  { "type": "integer" },
    "file_count":     { "type": "integer" },
    "ctf_count":      { "type": "integer" },
    "lab_count":      { "type": "integer" },
    "hunt_count":     { "type": "integer" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sample_id", "engagement_kind", "status"],
        "properties": {
          "sample_id":       { "type": "string" },
          "engagement_kind": { "type": "string", "enum": ["file", "ctf", "lab", "hunt"] },
          "name_tag":        { "type": "string" },
          "status":          { "type": "string" },
          "platform":        { "type": "string" },
          "date_started":    { "type": "string" },
          "date_closed":     { "type": "string" },
          "tags":            { "type": "array",  "items": { "type": "string" } },
          "skills":          { "type": "array",  "items": { "type": "string" } },
          "ioc_count":       { "type": "integer" },
          "has_frontmatter": { "type": "boolean" },
          "sha256":          { "type": "string" },
          "verdict":         { "type": "string" },
          "family_guess":    { "type": "string" },
          "mitre_techniques":{ "type": "array",  "items": { "type": "string" } },
          "category":        { "type": "string" },
          "difficulty":      { "type": "string" },
          "solved":          { "type": "string" },
          "course":          { "type": "string" },
          "objectives_met":  { "type": "string" },
          "hypothesis":      { "type": "string" },
          "detections_found":{ "type": "string" },
          "outcome":         { "type": "string" },
          "confidence":      { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  }
}
