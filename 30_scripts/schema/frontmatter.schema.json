{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Engagement findings frontmatter",
  "description": "YAML frontmatter schema for 03_findings/sample_XX.md. Version 1 is file-kind only. Version 2 supports all engagement kinds.",
  "type": "object",
  "required": ["schema_version", "analyst"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1, 2],
      "description": "1 = file kind (legacy), 2 = any kind"
    },
    "engagement_kind": {
      "type": "string",
      "enum": ["file", "ctf", "lab", "hunt"],
      "description": "Engagement kind. Absent or 'file' = legacy file analysis."
    },
    "analyst": { "type": "string" },

    "title": {
      "type": "string",
      "description": "Human-readable title (CTF/lab/hunt). Maps to name_tag for file kind."
    },
    "date_started": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "date_closed":  { "type": "string", "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$" },

    "status":  { "type": "string" },
    "outcome": { "type": "string", "enum": ["success", "partial", "failed", "abandoned", "unknown"] },
    "confidence": { "type": "string", "enum": ["high", "medium-high", "medium", "low"] },
    "tags":   { "type": "array", "items": { "type": "string" } },
    "skills": { "type": "array", "items": { "type": "string" } },

    "_file_schema_v1_fields": {
      "description": "Fields required when schema_version=1 or engagement_kind=file",
      "$comment": "Validated by validate.ps1 for file-kind rows only"
    },
    "sample_id":         { "type": "string", "pattern": "^sample_[0-9]{2}$" },
    "name_tag":          { "type": "string" },
    "sha256":            { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "phase":             { "type": "string", "const": "findings" },
    "date_acquired":     { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "date_analyzed":     { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "verdict":           { "type": "string", "enum": ["benign", "suspicious", "malicious", "unknown"] },
    "sample_type":       { "type": "string", "enum": ["PE", "Office", "Script", "Archive"] },
    "family_guess":      { "type": "string" },
    "family_confidence": { "type": "string", "enum": ["high", "medium-high", "medium", "low"] },
    "mitre_techniques":  { "type": "array", "items": { "type": "string" } },
    "mb_url":            { "type": "string", "pattern": "^https?://" },
    "procmon_run":       { "type": ["boolean", "string"] },
    "dynamic_complete":  { "type": ["boolean", "string"] },

    "_ctf_fields": { "description": "Fields used when engagement_kind=ctf" },
    "platform":          { "type": "string" },
    "category":          { "type": "string" },
    "difficulty":        { "type": "string", "enum": ["easy", "medium", "hard", "insane", ""] },
    "points":            { "type": ["integer", "string"] },
    "solved":            { "type": ["boolean", "string"] },
    "public_writeup_safe": { "type": ["boolean", "string"] },

    "_lab_fields": { "description": "Fields used when engagement_kind=lab" },
    "course":          { "type": "string" },
    "module":          { "type": "string" },
    "environment":     { "type": "string" },
    "objectives":      { "type": "array", "items": { "type": "string" } },
    "objectives_met":  { "type": ["boolean", "string"] },

    "_hunt_fields": { "description": "Fields used when engagement_kind=hunt" },
    "hypothesis":      { "type": "string" },
    "data_sources":    { "type": "array", "items": { "type": "string" } },
    "timebox":         { "type": "string" },
    "detections_found": { "type": ["boolean", "string"] },
    "ioc_count":       { "type": ["integer", "string"] }
  },
  "additionalProperties": true
}
